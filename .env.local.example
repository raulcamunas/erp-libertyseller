# Fichero de EJEMPLO. Nadie lo lee en tiempo de ejecucion: se copia a .env.local
# y se rellena con los valores de verdad.
#
# QUE IMPIDE tener marcadores en vez de los valores reales: antes aqui estaban
# la URL real del proyecto de Supabase y una clave anonima real, y este fichero
# esta versionado en git (git ls-files lo lista).
#
# La clave anonima es publica por definicion —viaja dentro del bundle que se
# descarga el navegador— asi que no era una fuga por si misma. Lo que regalaba
# era la IDENTIDAD EXACTA del proyecto, que es justo lo primero que necesita
# alguien para empezar a probar politicas RLS y funciones RPC contra la base de
# produccion. Sin eso, hay que averiguarla antes.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANONIMA
